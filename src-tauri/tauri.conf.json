{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PROVE",
  "version": "0.2.1",
  "identifier": "app.prove.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PROVE",
        "width": 1100,
        "height": 860,
        "minWidth": 720,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.anthropic.com https://api.search.brave.com https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Prompt · Response · Output · Verification · Engine",
    "longDescription": "PROVE analyzes AI responses, classifies each claim by epistemic type, and verifies factual claims against the open web.",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
